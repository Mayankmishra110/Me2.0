# Copy to .env (gitignored). Secrets only; everything else lives in config/config.yaml.

# Telegram (create the bot with @BotFather; get your IDs from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
TELEGRAM_CHAT_ID=

# Dashboard login token (long random string) and the PIN hash is set with `mayank2 set-pin`
DASHBOARD_TOKEN=

# Free-tier LLM providers (use whichever you sign up for)
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Stock media
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Google (YouTube Data + Analytics) OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta (Instagram + Facebook Page)
META_APP_ID=
META_APP_SECRET=

# X (one developer app; two user accounts authorize it)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Pinterest
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
